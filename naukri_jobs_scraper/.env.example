# Canonical daily catalog database. This is the only database the collection pipeline writes.
JOB_READY_DATABASE_URL=

# Optional. Used only when application membership synchronization is explicitly requested.
# Confirm that write with --confirm-target host:port/database. Never pass the URL on the command line.
JOB_READY_APP_DATABASE_URL=

# Indeed GraphQL lookup. Leave empty to skip Indeed expiry checks.
INDEED_API_KEY=
