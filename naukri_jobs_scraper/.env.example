# Local / scraper Postgres (naukri_scraper table) — Railway service
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway

# CodeQuest app Postgres (scraped_jobs + job_scrape_runs) — dual-write target
CODEQUEST_DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway

# Testing Postgres (job scraper experiments) — service: Postgres-4BfY
# Copy to .env.testing and use: python run_scraper.py --env-file .env.testing

# Optional: job-ready catalog Postgres public URL (validated_jobs). Required by catalog push and audits.
JOB_READY_DATABASE_URL=

# Optional: JobReady application Postgres. Required only when a command is explicitly
# allowed to update application jobs. Confirm writes with --confirm-target host:port/database.
# Never put the URL on the command line.
JOB_READY_APP_DATABASE_URL=

# Indeed GraphQL lookup. Leave empty to skip Indeed expiry checks.
INDEED_API_KEY=

